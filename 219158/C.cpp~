#include<iostream>

using namespace std;

int main()
{
  int x, y;
  cin >> x >> y;

  int a = 3, b = 4;
  float c = a / (float)b;
  
  cout << c << endl; // 0.75
  
  cout << x << " + " << y << " = "  << x + y << endl; 
  cout << x << " * " << y << " = " <<  (long long)x * y << endl;
  cout << x << " - " << y << " = " << x - y << endl;
  
  return 0;
}
